# Public URL the site is served from. PayFast redirects back here and posts
# payment notifications (ITN) to BASE_URL/api/payfast/notify, so for ITN to
# work this must be reachable from the internet (e.g. an ngrok URL locally).
BASE_URL=http://localhost:3000
PORT=3000

# PayFast. Defaults below are PayFast's shared sandbox test account.
# For proper testing, create your own free sandbox account at
# https://sandbox.payfast.co.za, set a passphrase under Settings, and put
# your own merchant ID, key and passphrase here. With a passphrase set,
# every payment request and notification is signed and verified.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=

# Flat delivery fee in rand. Collection is free.
DELIVERY_FEE=95
