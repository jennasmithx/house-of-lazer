# Copy to .env for local development (npm run dev). On Vercel, add the same
# variables under Project > Settings > Environment Variables.

# Public URL of the site. PayFast returns customers here and posts payment
# notifications to SITE_URL/api/payfast-notify, so for notifications to work
# it must be reachable from the internet (your Vercel URL, or an ngrok URL
# locally). On Vercel it defaults to the deployment URL if unset.
SITE_URL=http://localhost:3000

# Supabase: Project Settings > API.
SUPABASE_URL=
# Publishable (anon) key. Safe to expose; sent to the browser for login.
SUPABASE_ANON_KEY=
# Secret service role key. Server only, never put this in public/.
SUPABASE_SERVICE_ROLE_KEY=

# PayFast. Defaults are PayFast's shared sandbox account. For proper testing,
# create your own at https://sandbox.payfast.co.za, set a passphrase under
# Settings, and put your own merchant ID, key and passphrase here.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=

# Flat delivery fee in rand. Collection is free.
DELIVERY_FEE=95

# Email via Resend (https://resend.com). Emails are skipped until the API key
# is set. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=House of Lazer <orders@houseoflazer.co.za>
# Where new-order and contact-form alerts are sent.
STORE_EMAIL=
